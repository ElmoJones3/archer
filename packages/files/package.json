{
  "name": "@archer/files",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./workspace/conformance": {
      "types": "./dist/workspace/conformance.d.ts",
      "import": "./dist/workspace/conformance.js"
    },
    "./materializer": {
      "types": "./dist/materializer/index.d.ts",
      "import": "./dist/materializer/index.js"
    },
    "./materializer/directory": {
      "types": "./dist/materializer/index.d.ts",
      "import": "./dist/materializer/index.js"
    },
    "./materializer/conformance": {
      "types": "./dist/materializer/conformance.d.ts",
      "import": "./dist/materializer/conformance.js"
    },
    "./scratchpad": {
      "types": "./dist/scratchpad/index.d.ts",
      "import": "./dist/scratchpad/index.js"
    },
    "./scratchpad/conformance": {
      "types": "./dist/scratchpad/conformance.d.ts",
      "import": "./dist/scratchpad/conformance.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@archer/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@archer/eslint": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
