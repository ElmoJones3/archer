{
  "name": "archer",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:licenses": "node scripts/check-package-licenses.mjs",
    "example:core": "pnpm --filter @archer/example-core-documentation-indexer... build && pnpm --filter @archer/example-core-documentation-indexer demo",
    "example:cells:webhook": "pnpm --filter @archer/example-cells-durable-webhook... build && pnpm --filter @archer/example-cells-durable-webhook demo",
    "example:files:cache": "pnpm --filter @archer/example-files-local-snapshot-cache... build && pnpm --filter @archer/example-files-local-snapshot-cache demo",
    "example:files:code-editor": "pnpm --filter @archer/example-files-vercel-ai-sdk-code-editor... build && pnpm --filter @archer/example-files-vercel-ai-sdk-code-editor demo",
    "example:files:fingerprint": "pnpm --filter @archer/example-files-directory-fingerprint... build && pnpm --filter @archer/example-files-directory-fingerprint demo",
    "example:files:notebook": "pnpm --filter @archer/example-files-vercel-ai-sdk-notebook-agent... build && pnpm --filter @archer/example-files-vercel-ai-sdk-notebook-agent demo",
    "example:observability": "pnpm --filter @archer/example-observability-word-count-service... build && pnpm --filter @archer/example-observability-word-count-service demo",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "engines": {
    "node": ">=26.7.0 <27",
    "pnpm": ">=11.22.0 <12"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@archer/eslint": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  }
}
